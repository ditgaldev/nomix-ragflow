{
  "name": "@nomix-ai/nomix-ragflow",
  "version": "0.3.0",
  "description": "RAGFlow server client and business Knowledge Gateway Harness plugin",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./client": {
      "types": "./lib/src/client.d.ts",
      "default": "./lib/src/client.js"
    },
    "./plugin": {
      "types": "./lib/packages/dsh-bundle-ragflow-knowledge/plugin.d.ts",
      "default": "./lib/packages/dsh-bundle-ragflow-knowledge/plugin.js"
    },
    "./gateway-provider": {
      "types": "./lib/packages/dsh-knowledge-gateway/provider.d.ts",
      "default": "./lib/packages/dsh-knowledge-gateway/provider.js"
    },
    "./business-identity": {
      "types": "./lib/packages/dsh-business-identity/business-identity.d.ts",
      "default": "./lib/packages/dsh-business-identity/business-identity.js"
    },
    "./types": {
      "types": "./lib/src/types.d.ts",
      "default": "./lib/src/types.js"
    },
    "./errors": {
      "types": "./lib/src/errors.d.ts",
      "default": "./lib/src/errors.js"
    },
    "./knowledge-contract": {
      "types": "./lib/packages/dsh-knowledge/knowledge-openapi.generated.d.ts",
      "default": "./lib/packages/dsh-knowledge/knowledge-openapi.generated.js"
    },
    "./knowledge-openapi.json": "./contracts/knowledge-gateway.openapi.json",
    "./manifest": {
      "types": "./lib/src/manifest.d.ts",
      "default": "./lib/src/manifest.js"
    },
    "./service": {
      "types": "./lib/packages/dsh-knowledge/service.d.ts",
      "default": "./lib/packages/dsh-knowledge/service.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "contracts/ALIGNMENT.md",
    "contracts/GATEWAY-INTEGRATION.md",
    "contracts/knowledge-gateway.openapi.json",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.json",
    "packages/dsh-bundle-ragflow-knowledge/cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-ragflow.git",
    "directory": "integrations/nomix-harness"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "nomix": {
    "bundle": {
      "patch": "./packages/dsh-bundle-ragflow-knowledge/cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "lint": "oxlint src packages tests scripts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "contracts:generate": "node scripts/generate-openapi-types.mjs && node scripts/generate-knowledge-contract.mjs",
    "contracts:check": "node scripts/generate-openapi-types.mjs --check && node scripts/generate-knowledge-contract.mjs --check",
    "verify:source": "npm run contracts:check && npm run typecheck && npm run typecheck:workspaces && npm run lint && npm run test && npm run build",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "npm run verify:source && npm run verify:package",
    "prepack": "npm run verify:source",
    "typecheck:workspaces": "npm run typecheck --workspaces"
  },
  "dependencies": {
    "@nomix-ai/nomix-harness": "0.2.9"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "oxlint": "1.14.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "workspaces": [
    "packages/*"
  ]
}
