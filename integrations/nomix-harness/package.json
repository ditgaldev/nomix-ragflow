{
  "name": "@nomix-ai/nomix-ragflow",
  "version": "1.0.2",
  "description": "Nomix RAGFlow Business Gateway client and Agent-scoped Harness integration",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./plugin": {
      "types": "./lib/plugin.d.ts",
      "default": "./lib/plugin.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./errors": {
      "types": "./lib/errors.d.ts",
      "default": "./lib/errors.js"
    },
    "./manifest": {
      "types": "./lib/manifest.d.ts",
      "default": "./lib/manifest.js"
    },
    "./service": {
      "types": "./lib/service.d.ts",
      "default": "./lib/service.js"
    },
    "./provider": {
      "types": "./lib/provider.d.ts",
      "default": "./lib/provider.js"
    },
    "./consumer": {
      "types": "./lib/consumer.d.ts",
      "default": "./lib/consumer.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-ragflow.git",
    "directory": "integrations/nomix-harness"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "nomix": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "lint": "oxlint src tests scripts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "harness:link": "node scripts/link-harness-kernel.mjs",
    "contracts:generate": "node scripts/generate-openapi-types.mjs",
    "contracts:check": "node scripts/generate-openapi-types.mjs --check",
    "verify": "npm run harness:link && npm run contracts:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "prepack": "npm run verify"
  },
  "peerDependencies": {
    "@nomix-ai/nomix-harness": "^0.2.5"
  },
  "peerDependenciesMeta": {
    "@nomix-ai/nomix-harness": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nomix-ai/nomix-harness": "0.2.5",
    "@types/node": "24.5.2",
    "oxlint": "1.14.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
