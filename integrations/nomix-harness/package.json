{
  "name": "@nomix-ai/nomix-ragflow",
  "version": "0.1.0",
  "description": "RAGFlow client and Nomix Harness plugin",
  "license": "Apache-2.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ditgaldev/nomix-ragflow.git",
    "directory": "integrations/nomix-harness"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "lint": "oxlint src tests scripts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "prepack": "npm run verify"
  },
  "peerDependencies": {
    "@nomix-ai/cordis": "^4.0.1",
    "@nomix-ai/nomix-fs": "^0.2.4",
    "@nomix-ai/nomix-launch-environment": "^0.2.4",
    "@nomix-ai/nomix-mcp-client": "^0.2.4",
    "@nomix-ai/nomix-tools": "^0.2.4"
  },
  "dependencies": {
    "@nomix-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@nomix-ai/cordis": "4.0.1",
    "@nomix-ai/nomix-fs": "0.2.4",
    "@nomix-ai/nomix-launch-environment": "0.2.4",
    "@nomix-ai/nomix-mcp-client": "0.2.4",
    "@nomix-ai/nomix-tools": "0.2.4",
    "@types/node": "24.5.2",
    "oxlint": "1.14.0",
    "tsdown": "0.15.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
