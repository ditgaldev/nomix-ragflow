      "retrySafe": true,
      "idempotency": "none",
      "responseSchema": "RetrievalResult",
      "toolSchema": "KnowledgeSearchToolInput",
      "requestSchema": "RetrievalRequest"
    },
    {
      "operation": "knowledgeSpaceCreate",
      "method": "POST",
