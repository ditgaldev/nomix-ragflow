# Public dedicated Business Gateway listener.
BUSINESS_GATEWAY_PORT=9480
RAGFLOW_BUSINESS_UPSTREAM=ragflow-business-upstream:9380
BUSINESS_GATEWAY_TLS_CERT_FILE=./secrets/business-gateway-tls.crt
BUSINESS_GATEWAY_TLS_KEY_FILE=./secrets/business-gateway-tls.key

# Original Web/API/admin/SDK listeners stay on a management-only interface.
# Set this to a private management address when loopback is not sufficient.
RAGFLOW_MANAGEMENT_BIND_ADDRESS=127.0.0.1

# Quart token introspection. Keep the client secret in the deployment secret
# store; this example intentionally contains no credential value.
NOMIX_BG_INTROSPECTION_URL=https://identity.example.com/oauth2/introspect
NOMIX_BG_AUTHORITY=https://identity.example.com
NOMIX_BG_AUDIENCE=nomix-ragflow-data
# Generate independently from the introspection credential; minimum 32 bytes.
NOMIX_BG_CURSOR_SECRET=
NOMIX_BG_INTROSPECTION_AUTH_MODE=basic
NOMIX_BG_INTROSPECTION_CLIENT_ID=nomix-ragflow-gateway
NOMIX_BG_INTROSPECTION_CLIENT_SECRET=
NOMIX_BG_INTROSPECTION_TIMEOUT_SECONDS=3
NOMIX_BG_INTROSPECTION_RETRIES=1
NOMIX_BG_INTROSPECTION_CACHE_SECONDS=5
NOMIX_BG_INTROSPECTION_MAX_CONNECTIONS=100
# Upload budgets are intentionally layered: 64 MiB per file, 72 MiB for the
# complete Quart request, and 80 MiB at the public proxy. The request budget
# must reserve at least 8 MiB for multipart fields and boundaries.
NOMIX_BG_MAX_FILE_BYTES=67108864
NOMIX_BG_MAX_REQUEST_BYTES=75497472
NOMIX_BG_PROXY_MAX_REQUEST_BYTES=83886080
NOMIX_BG_READINESS_TIMEOUT_SECONDS=5
# Versioned Gateway writes are serialized with RAGFlow's existing Redis.
NOMIX_BG_CONCURRENCY_LOCK_SECONDS=900
NOMIX_BG_CONCURRENCY_WAIT_SECONDS=2

# For mTLS, set auth mode to mtls and mount these files into the RAGFlow API
# container. The files are server-only and must not enter an npm package.
# NOMIX_BG_INTROSPECTION_CA_FILE=/run/secrets/introspection-ca.pem
# NOMIX_BG_INTROSPECTION_CERT_FILE=/run/secrets/introspection-client.pem
# NOMIX_BG_INTROSPECTION_KEY_FILE=/run/secrets/introspection-client-key.pem
