server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    server_tokens off;
    client_max_body_size ${BUSINESS_GATEWAY_MAX_BODY_SIZE};
    ssl_certificate /run/secrets/business-gateway-tls.crt;
    ssl_certificate_key /run/secrets/business-gateway-tls.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:BusinessGatewayTLS:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Metrics are scraped over the management network directly from Quart.
    # They are intentionally absent from the public data-plane service root.
    location = /api/v1/_metrics {
        return 404;
    }

    # This service root deliberately exposes only the Business Gateway plane.
    location ^~ /api/v1/ {
        rewrite ^/api/v1/(.*)$ /api/business/v1/$1 break;
        proxy_pass http://${RAGFLOW_BUSINESS_UPSTREAM};
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Authorization context is always created by Quart after token
        # introspection. Ingress-supplied identity and scope headers are erased.
        proxy_set_header X-Actions "";
        proxy_set_header X-Data-Scope "";
        proxy_set_header X-Dataset-Scope "";
        proxy_set_header X-Document-Scope "";
        proxy_set_header X-Chat-Scope "";
        proxy_set_header X-Agent-Scope "";
        proxy_set_header X-Memory-Scope "";
        proxy_set_header X-Workspace "";
        proxy_set_header X-Workspace-Id "";
        proxy_set_header X-Subject "";
        proxy_set_header X-Actor-Subject "";
        proxy_set_header X-On-Behalf-Of-Subject "";
        proxy_set_header X-Tenant "";
        proxy_set_header X-Tenant-Id "";
        proxy_set_header X-Permission-Ref "";
        proxy_set_header X-Nomix-Actions "";
        proxy_set_header X-Nomix-Data-Scope "";
        proxy_set_header X-Nomix-Dataset-Scope "";
        proxy_set_header X-Nomix-Document-Scope "";
        proxy_set_header X-Nomix-Chat-Scope "";
        proxy_set_header X-Nomix-Agent-Scope "";
        proxy_set_header X-Nomix-Memory-Scope "";
        proxy_set_header X-Nomix-Workspace "";
        proxy_set_header X-Nomix-Workspace-Id "";
        proxy_set_header X-Nomix-Subject "";
        proxy_set_header X-Nomix-Actor-Subject "";
        proxy_set_header X-Nomix-On-Behalf-Of-Subject "";
        proxy_set_header X-Nomix-Tenant "";
        proxy_set_header X-Nomix-Tenant-Id "";
        proxy_set_header X-Nomix-Permission-Ref "";
    }

    # No original RAGFlow API, Web UI, login, admin, SDK, or internal prefix is
    # reachable through the Business Gateway service root.
    location / {
        return 404;
    }
}
